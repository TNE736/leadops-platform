# ─────────────────────────────────────────────────────────────
# LeadOps — local environment. Read by the frontend (Next.js) and the
# backend API (backend/integrations/main.py loads this file). Gitignored.
# In the cloud, set these SAME names to the deployed https URLs / secrets.
# No PORT lines: ports come from `uvicorn --port` locally and Cloud Run's
# $PORT in the cloud; the URLs below just carry a host:port on localhost.
# ─────────────────────────────────────────────────────────────

# ── Addresses the BROWSER uses (NEXT_PUBLIC_ = visible to the browser) ──
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_LIVE_UPDATES_URL=http://localhost:4000/events
NEXT_PUBLIC_LIVE_UPDATES_WS_URL=

# ── Addresses the BACKEND uses (server-side only) ──
LIVE_UPDATES_GATEWAY_URL=http://localhost:4000
UI_GATEWAY_PUBLIC_URL=
LEADS_FORWARD_AUTH_TOKEN=
ALLOWED_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Secrets (keys) — keep out of git; use Secret Manager in cloud ──
HUBSPOT_READ_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
